# WeatherGPT Backend Configuration (SIH PS 26068)
PROJECT_NAME="WeatherGPT"
DEBUG=False
API_V1_STR="/api/v1"

# Database Configuration (Supabase / Render / Neon PostgreSQL with PostGIS + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@your_db_host:5432/postgres

# Security & CORS
JWT_SECRET=supersecretjwtkey_change_in_production_min32chars
CORS_ORIGINS=["*"]

# External Meteorological & AI APIs
OPENAI_API_KEY=your_openai_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
